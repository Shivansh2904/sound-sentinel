{
  "name": "sound-sentinel",
  "version": "1.0.0",
  "description": "In-browser environmental sound classification with ONNX Runtime Web (work in progress)",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
